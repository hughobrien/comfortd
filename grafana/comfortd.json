          "expr": "max by (unit) (\n    (max by (unit) (comfortd_power{unit=~\"${unit:regex}\"}) == 0) * 0\n  or (max by (unit) (comfortd_mode{unit=~\"${unit:regex}\",mode=\"off\"}) == 1) * 0\n  or (max by (unit) (comfortd_alert{unit=~\"${unit:regex}\",alert=\"defrost\"}) == 1) * 11\n  or (max by (unit) (comfortd_alert{unit=~\"${unit:regex}\",alert=\"hot_adjust\"}) == 1) * 10\n  or (max by (unit) (comfortd_alert{unit=~\"${unit:regex}\",alert=\"standby\"}) == 1) * 12\n  or max by (unit) (comfortd_mode{unit=~\"${unit:regex}\",mode=\"heat\"}) * 1\n  or max by (unit) (comfortd_mode{unit=~\"${unit:regex}\",mode=\"cool\"}) * 2\n  or max by (unit) (comfortd_mode{unit=~\"${unit:regex}\",mode=~\"auto|autoHeat|autoCool\"}) * 3\n  or max by (unit) (comfortd_mode{unit=~\"${unit:regex}\",mode=\"dry\"}) * 4\n  or max by (unit) (comfortd_mode{unit=~\"${unit:regex}\",mode=\"vent\"}) * 5\n)",
          "instant": true,
          "legendFormat": "state",
          "range": false,
          "refId": "A"
        }
