  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Anything that wants a human: offline or stale units, cloud disconnects, filter, thermostat battery, failing endpoints, push socket down.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "orange",
            "mode": "fixed"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "All clear"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "label_replace(max by (unit) (comfortd_up{unit=~\"$unit\"}) == 0, \"issue\", \"offline or stale\", \"\", \"\")\nor label_replace(max by (unit) (comfortd_connected{unit=~\"$unit\"}) == 0, \"issue\", \"indoor unit not connected to cloud\", \"\", \"\")\nor label_replace(max by (unit) (comfortd_alert{unit=~\"$unit\",alert=\"filter\"}) == 1, \"issue\", \"clean the filter\", \"\", \"\")\nor label_replace(max by (unit) (comfortd_thermostat_battery_ok{unit=~\"$unit\"}) == 0, \"issue\", \"thermostat battery low\", \"\", \"\")\nor label_replace(max by (unit) (time() - comfortd_last_poll_timestamp_seconds{unit=~\"$unit\"}) > 600, \"issue\", \"no successful poll for 10m+\", \"\", \"\")\nor label_replace(max by (unit, endpoint) (comfortd_endpoint_error{unit=~\"$unit\"}) == 1, \"issue\", \"$1 endpoint failing\", \"endpoint\", \"(.*)\")\nor label_replace(label_replace(max(comfortd_socket_connected) == 0, \"issue\", \"push socket down\", \"\", \"\"), \"unit\", \"comfortd\", \"\", \"\")",
          "instant": true,
          "legendFormat": "{{unit}}: {{issue}}",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "absent(\nlabel_replace(max by (unit) (comfortd_up{unit=~\"$unit\"}) == 0, \"issue\", \"offline or stale\", \"\", \"\")\nor label_replace(max by (unit) (comfortd_connected{unit=~\"$unit\"}) == 0, \"issue\", \"indoor unit not connected to cloud\", \"\", \"\")\nor label_replace(max by (unit) (comfortd_alert{unit=~\"$unit\",alert=\"filter\"}) == 1, \"issue\", \"clean the filter\", \"\", \"\")\nor label_replace(max by (unit) (comfortd_thermostat_battery_ok{unit=~\"$unit\"}) == 0, \"issue\", \"thermostat battery low\", \"\", \"\")\nor label_replace(max by (unit) (time() - comfortd_last_poll_timestamp_seconds{unit=~\"$unit\"}) > 600, \"issue\", \"no successful poll for 10m+\", \"\", \"\")\nor label_replace(max by (unit, endpoint) (comfortd_endpoint_error{unit=~\"$unit\"}) == 1, \"issue\", \"$1 endpoint failing\", \"endpoint\", \"(.*)\")\nor label_replace(label_replace(max(comfortd_socket_connected) == 0, \"issue\", \"push socket down\", \"\", \"\"), \"unit\", \"comfortd\", \"\", \"\")\n)",
          "instant": true,
          "legendFormat": "All clear",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Needs attention",
      "type": "stat"
    },
