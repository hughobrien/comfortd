                },
                "2": {
                  "color": "blue",
                  "index": 0,
                  "text": "Cool"
                },
                "20": {
                  "color": "#808080",
                  "index": 0,
                  "text": "Auto"
                },
                "21": {
                  "color": "super-light-blue",
                  "index": 0,
                  "text": "Super quiet"
                },
                "22": {
                  "color": "light-blue",
                  "index": 0,
                  "text": "Quiet"
                },
                "23": {
                  "color": "blue",
                  "index": 0,
                  "text": "Low"
                },
                "24": {
                  "color": "semi-dark-blue",
                  "index": 0,
                  "text": "Powerful"
                },
                "25": {
                  "color": "dark-blue",
                  "index": 0,
                  "text": "Super powerful"
                },
                "3": {
                  "color": "purple",
                  "index": 0,
                  "text": "Auto"
                },
                "30": {
                  "color": "#808080",
                  "index": 0,
                  "text": "Manual"
                },
                "31": {
                  "color": "semi-dark-green",
                  "index": 0,
                  "text": "Schedule"
                },
                "32": {
                  "color": "yellow",
                  "index": 0,
                  "text": "Hold"
                },
                "4": {
                  "color": "semi-dark-yellow",
                  "index": 0,
                  "text": "Dry"
                },
                "5": {
                  "color": "super-light-purple",
                  "index": 0,
                  "text": "Fan only"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#808080",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 4
