      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (unit) (comfortd_setpoint_celsius{unit=~\"${unit:regex}\",kind=\"heat\"}) and on (unit) max by (unit) (comfortd_mode{unit=~\"${unit:regex}\",mode=~\"heat|auto|autoHeat|autoCool\"})",
          "instant": true,
          "legendFormat": "heat",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (unit) (comfortd_setpoint_celsius{unit=~\"${unit:regex}\",kind=\"cool\"}) and on (unit) max by (unit) (comfortd_mode{unit=~\"${unit:regex}\",mode=~\"cool|dry|auto|autoHeat|autoCool\"})",
          "instant": true,
          "legendFormat": "cool",
          "range": false,
          "refId": "B"
        }
