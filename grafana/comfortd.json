      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "#808080",
                  "index": 0,
                  "text": "Off"
                },
                "1": {
                  "color": "orange",
                  "index": 0,
                  "text": "Heat"
                },
                "10": {
                  "color": "light-orange",
                  "index": 0,
