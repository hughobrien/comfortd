package templates

import (
	"strconv"

	"github.com/hughobrien/comfortd/cmd/comfortd/ui"
)

templ UnitSection(v ui.UnitView) {
	<section id={ "unit-" + v.Slug } class="unit">
		<h2>
			{ v.Name }
			<small>{ v.Serial }</small>
			if v.Stale {
				<span class="badge stale">stale</span>
			}
			if v.LastOK != "" {
				<small>last ok { v.LastOK }</small>
			}
		</h2>
		@Card(v.Card)
		if len(v.Unknown) > 0 {
			<details class="unknown">
				<summary>Unknown fields <small>{ strconv.Itoa(len(v.Unknown)) }</small></summary>
				<table>
					for _, r := range v.Unknown {
						<tr class={ rowClass(r) }>
							<td class="path">{ r.Path }</td>
							<td class="val">{ r.Value }</td>
						</tr>
					}
				</table>
			</details>
		}
		for _, e := range v.Endpoints {
			<details open?={ e.Name == "device" }>
				<summary>
					{ e.Name }
					if e.At != "" {
						<small>{ e.At }</small>
					}
					if e.Error != "" {
						<span class="badge err">{ e.Error }</span>
					}
				</summary>
				<table>
					for _, r := range e.Rows {
						<tr class={ rowClass(r) }>
							<td class="path">
								{ r.Path }
								if r.Label != "" {
									<br/><span class={ "conf-" + r.Confidence } title={ r.Note }>{ r.Label } · { r.Confidence }</span>
								}
							</td>
							<td class="val">
								{ r.Value }
								if r.Decoded != "" {
									<br/><em>{ r.Decoded }</em>
								}
							</td>
						</tr>
					}
				</table>
			</details>
		}
	</section>
}

func rowClass(r ui.Row) string {
	switch {
	case r.Changed:
		return "changed"
	case r.Noisy:
		return "noisy"
	}
	return ""
}
