package templates

import (
	"strconv"
	"strings"

	"github.com/hughobrien/comfortd/cmd/comfortd/ui"
)

templ UnitSection(v ui.UnitView) {
	if v.Inactive {
		<section id={ "unit-" + v.Slug } class="unit inactive">
			<h2>{ v.Name } <small>not enabled yet</small></h2>
		</section>
	} else {
		@activeUnit(v)
	}
}

templ activeUnit(v ui.UnitView) {
	<section id={ "unit-" + v.Slug } class="unit">
		<h2>
			{ v.Name }
			for _, a := range v.Card.Alerts {
				<span class="alert-flag">{ a }</span>
			}
			if v.Card.HoldUntil != "" {
				<span class="hold-flag">{ v.Card.HoldUntil }</span>
			}
			if v.Stale {
				<span class="badge stale">stale</span>
			}
			if v.LastOK != "" {
				<small>as at { v.LastOK }</small>
			}
		</h2>
		@Card(v.Card)
		if len(v.Endpoints) > 0 {
			<details class="kv raw" data-preserve-attr="open">
				<summary>
					Raw data
				</summary>
			for _, e := range v.Endpoints {
				<details class="endpoint" data-preserve-attr="open">
					<summary>
						{ e.Name }
						if e.At != "" {
							<small>{ e.At }</small>
						}
						if e.Error != "" {
							<span class="badge err">{ e.Error }</span>
						}
					</summary>
					{{ top, groups := e.Split() }}
					<table>
						for _, r := range top {
							@fieldRow(r, r.Path)
						}
					</table>
					for _, g := range groups {
						<details class="group" data-preserve-attr="open">
							<summary>
								{ g.Name }
								<small>{ strconv.Itoa(len(g.Rows)) }</small>
								if g.Changed {
									<span class="badge">changed</span>
								}
							</summary>
							<table>
								for _, r := range g.Rows {
									@fieldRow(r, strings.TrimPrefix(strings.TrimPrefix(strings.TrimPrefix(r.Path, "[0]."), g.Name), "."))
								}
							</table>
						</details>
					}
				</details>
			}
			</details>
		}
	</section>
}

func rowClass(r ui.Row) string {
	switch {
	case r.Changed:
		return "changed"
	case r.Noisy:
		return "noisy"
	}
	return ""
}

templ fieldRow(r ui.Row, name string) {
	<tr class={ rowClass(r) }>
		<td class="path">
			{ name }
		</td>
		<td class={ "val", templ.KV("nul", r.Value == "null" || r.Value == "" || r.Value == "{}" || r.Value == "[]") }>
			{ r.Value }
			if r.Decoded != "" {
				<br/><em>{ r.Decoded }</em>
			}
		</td>
	</tr>
}
