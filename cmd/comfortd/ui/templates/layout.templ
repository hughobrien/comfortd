package templates

import (
	"github.com/hughobrien/comfortd/cmd/comfortd/ui"
	"github.com/hughobrien/comfortd/internal/history"
)

// BuildID names this build of the daemon. The page carries it in a meta tag
// and the event stream checks it on every (re)connect, so a tab left open
// across a deploy reloads itself instead of mixing new markup with old CSS.
var BuildID = "dev"

// Page renders the explorer shell. The body opens /ui/sse on first datastar
// processing; the server then patches every unit section and the feed.
templ Page(units []ui.UnitView, feed []history.Record) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>comfortd</title>
			<meta name="build" content={ BuildID }/>
			<link rel="stylesheet" href="/ui/static/style.css"/>
			<script type="module" src="/ui/static/datastar.js"></script>
			<script defer src="/ui/static/dial.js"></script>
		</head>
		<body data-init="@get('/ui/sse', {retry: 'always', retryMaxCount: 100000, retryMaxWait: 5000})">
			<header><h1>comfortd</h1></header>
			<div class="layout">
				<main id="units">
					for _, u := range units {
						@UnitSection(u)
					}
				</main>
				<aside>
					<details class="events" data-preserve-attr="open">
						<summary>Events</summary>
						<ol id="feed">
							for _, r := range feed {
								@FeedRow(r)
							}
						</ol>
					</details>
				</aside>
			</div>
		</body>
	</html>
}
