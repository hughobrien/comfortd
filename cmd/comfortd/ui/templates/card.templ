package templates

import (
	"fmt"

	"github.com/hughobrien/comfortd/cmd/comfortd/ui"
)

templ Card(c ui.CardView) {
	<div class="card">
		if c.Stale {
			<p class="stale-banner">stale: no fresh data since { c.LastOK }</p>
		}
		<div class="head">
			<div class="big">
				{ c.RoomTemp } °C
			</div>
			if c.Image != "" {
				<img class="model" src={ c.Image } alt="" loading="lazy"/>
			}
			if len(c.Modes) > 0 {
				<button
					type="button"
					class="power-toggle"
					aria-pressed={ boolStr(c.On) }
					data-on:click={ powerClick(c) }
				>power</button>
			}
		</div>
		<div class="sub">room · { c.Mode }</div>
		if c.Control.LastError != "" {
			<p class="ctl-error">last command failed: { c.Control.LastError }</p>
		}
		if len(c.Modes) > 0 {
			<div class="ctrl">
				<span class="ctrl-label">MODE</span>
				@seg(c, c.Modes, "mode", "m", "operationMode")
			</div>
			if c.ShowHeat {
				@setpointRow(c, "HEAT TO", "spheat", "spHeat", c.SpHeat)
			}
			if c.ShowCool {
				@setpointRow(c, "COOL TO", "spcool", "spCool", c.SpCool)
			}
		}
		if len(c.Fans) > 0 || len(c.Vanes) > 0 {
			<div class="dials">
			if len(c.Fans) > 0 {
				<div class="ctrl">
					<span class="ctrl-label">FAN</span>
					@dial(c, c.Fans, "fan", "fanSpeed", true, "auto")
				</div>
			}
			if len(c.Vanes) > 0 {
				<div class="ctrl">
					<span class="ctrl-label">VANE</span>
					@dial(c, c.Vanes, "vane", "airDirection", false, "auto", "swing")
				</div>
			}
			</div>
		}
		<details class="kv" data-preserve-attr="open">
			<summary>Status</summary>
			<div class="row"><span>Power</span><span>{ c.Power }</span></div>
			<div class="row"><span>Heat to / cool to</span><span>{ c.SpHeat } / { c.SpCool } °C</span></div>
			<div class="row"><span>Humidity</span><span>{ c.Humidity }</span></div>
			<div class="row"><span>Schedule</span><span>{ yesNo(c.ScheduleActive) }{ holdSuffix(c.HoldEnabled) }</span></div>
			<div class="row"><span>Adapter</span><span>{ connText(c.Connected) }</span></div>
		</details>
	</div>
}

// setpointRow is a labelled slider with a text box that follow each other;
// the change is posted on release. Limits are the unit's own min/max.
templ setpointRow(c ui.CardView, label, path, field, value string) {
	if c.SpMin != "" && c.SpMax != "" {
		<div class="ctrl">
			<span class="ctrl-label">{ label }</span>
			<div class="slider-row">
				<span class="lim">{ c.SpMin }</span>
				<input
					type="range"
					min={ c.SpMin }
					max={ c.SpMax }
					step="0.5"
					value={ value }
					data-on:input="el.closest('.slider-row').querySelector('.val-input').value = evt.target.value"
					data-on:change={ setpointPost(c, path) }
				/>
				<span class="lim">{ c.SpMax }</span>
				<span class="val">
					<input
						type="number"
						class="val-input"
						min={ c.SpMin }
						max={ c.SpMax }
						step="0.5"
						value={ value }
						data-on:input="el.closest('.slider-row').querySelector('input[type=range]').value = evt.target.value"
						data-on:change={ setpointPost(c, path) }
					/><span class={ "val-suffix", templ.KV("pending", c.Control.Pending[field] != "") }>°C</span>
				</span>
			</div>
		</div>
	}
}

// seg renders a segmented control; the current value is the pressed button.
templ seg(c ui.CardView, opts []ui.Choice, path, param, field string) {
	<div class="seg">
		for _, o := range opts {
			<button
				type="button"
				aria-pressed={ boolStr(o.Pressed) }
				data-value={ o.Value }
				class={ templ.KV("pending", o.Pressed && c.Control.Pending[field] != "") }
				data-on:click={ "@post('/ui/units/" + c.Slug + "/" + path + "?" + param + "=" + o.Value + "')" }
			>{ o.Label }</button>
		}
	</div>
}

// dial renders a ring of wedges with the current value in the middle and the
// hub (auto) as a button; other extras (swing) fill the gap at the bottom.
templ dial(c ui.CardView, opts []ui.Choice, path, field string, level bool, extra ...string) {
	{{ wedges, buttons := dialSplit(opts, extra...) }}
	{{ hub, hasHub, rest := dialHub(buttons) }}
	<div class="dial">
		<svg viewBox="0 0 180 134" role="group">
			for _, a := range dialArcs(wedges, level, rest) {
				<path
					d={ a.Path }
					role="button"
					tabindex="0"
					aria-label={ a.Label }
					aria-pressed={ boolStr(a.Pressed) }
					data-value={ a.Value }
					class={ templ.KV("lit", a.Lit), templ.KV("pending", a.Pressed && c.Control.Pending[field] != "") }
					data-on:click={ "@post('/ui/units/" + c.Slug + "/" + path + "?v=" + a.Value + "')" }
				><title>{ a.Label }</title></path>
				<text class="wl" x={ fmt.Sprintf("%.1f", a.LX) } y={ fmt.Sprintf("%.1f", a.LY) } text-anchor={ a.Anchor } dominant-baseline="middle">{ a.Label }</text>
			}
			if hasHub {
				<circle
					class={ "hub", templ.KV("pending", hub.Pressed && c.Control.Pending[field] != "") }
					cx="90"
					cy="70"
					r="24"
					role="button"
					tabindex="0"
					aria-label={ hub.Label }
					aria-pressed={ boolStr(hub.Pressed) }
					data-on:click={ "@post('/ui/units/" + c.Slug + "/" + path + "?v=" + hub.Value + "')" }
				><title>{ hub.Label }</title></circle>
			}
			<text class="center" x="90" y="70" text-anchor="middle" dominant-baseline="central">{ dialCenter(opts) }</text>
		</svg>
	</div>
}

// setpointPost sends the absolute value from the slider or text box; the
// controller range-checks it, so the clamp here is only for tidiness.
func setpointPost(c ui.CardView, path string) string {
	return "const v = Math.min(" + c.SpMax + ", Math.max(" + c.SpMin + ", parseFloat(evt.target.value))); if (!isNaN(v)) { @post('/ui/units/" + c.Slug + "/" + path + "?v=' + v) }"
}

func powerClick(c ui.CardView) string {
	m := "on"
	if c.On {
		m = "off"
	}
	return "@post('/ui/units/" + c.Slug + "/mode?m=" + m + "')"
}

func boolStr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func yesNo(b bool) string {
	if b {
		return "active"
	}
	return "none"
}

func holdSuffix(b bool) string {
	if b {
		return ", hold on"
	}
	return ""
}

func connText(b bool) string {
	if b {
		return "connected"
	}
	return "offline"
}
