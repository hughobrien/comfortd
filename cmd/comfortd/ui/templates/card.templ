package templates

import (
	"fmt"

	"github.com/hughobrien/comfortd/cmd/comfortd/ui"
)

templ Card(c ui.CardView) {
	<div class="card">
		if c.Stale {
			<p class="stale-banner">stale: no fresh data since { c.LastOK }</p>
		}
		if c.Control.LastError != "" {
			<p class="ctl-error">last command failed: { c.Control.LastError }</p>
		}
		<div class="dials">
			if len(c.Modes) == 0 {
				@roomTemp(c)
			}
			if len(c.Modes) > 0 {
				<div class="ctrl">
					<span class="ctrl-label">MODE</span>
					@dial(c, modeOpts(c), "mode", "m", "operationMode", "auto", false, "auto", "off")
				</div>
				@tempDial(c, tempWheel(c))
			}
			if c.Image != "" {
				<img class="model" src={ c.Image } alt="" loading="lazy"/>
			}
			if len(c.Fans) > 0 {
				<div class="ctrl">
					<span class="ctrl-label">FAN</span>
					@dial(c, c.Fans, "fan", "v", "fanSpeed", "auto", true, "auto")
				</div>
			}
			if len(c.Vanes) > 0 {
				<div class="ctrl">
					<span class="ctrl-label">VANE</span>
					@dial(c, c.Vanes, "vane", "v", "airDirection", "auto", false, "auto", "swing")
				</div>
			} else if len(c.Modes) > 0 {
				<div class="ctrl">
					<span class="ctrl-label">VANE</span>
					<div class="dial na">
						<svg viewBox="0 0 180 134" role="img" aria-label="Vane not available on this unit">
							<circle class="hub" cx="90" cy="70" r="24"><title>No vane on this unit</title></circle>
							<text class="center" x="90" y="70" text-anchor="middle" dominant-baseline="central">N/A</text>
						</svg>
					</div>
				</div>
			}
		</div>
		@scheduleSection(c)
	</div>
}

// dial renders a ring of wedges with the current value in the middle and the
// hub (auto, or off for the mode wheel) as a button; other extras (swing) fill the gap at the bottom.
templ dial(c ui.CardView, opts []ui.Choice, path, param, field, hubValue string, level bool, extra ...string) {
	{{ wedges, buttons := dialSplit(opts, extra...) }}
	{{ hub, hasHub, rest := dialHub(buttons, hubValue) }}
	<div class="dial">
		<svg viewBox="0 0 180 134" role="group">
			for _, a := range dialArcs(wedges, level, rest) {
				<path
					d={ a.Path }
					role="button"
					tabindex="0"
					aria-label={ a.Label }
					aria-pressed={ boolStr(a.Pressed) }
					data-value={ a.Value }
					class={ templ.KV("lit", a.Lit), templ.KV("pending", a.Pressed && c.Control.Pending[field] != "") }
					data-on:click={ "@post('/ui/units/" + c.Slug + "/" + path + "?" + param + "=" + a.Value + "')" }
				><title>{ a.Label }</title></path>
				<text class="wl" x={ fmt.Sprintf("%.1f", a.LX) } y={ fmt.Sprintf("%.1f", a.LY) } text-anchor={ a.Anchor } dominant-baseline="middle">{ a.Label }</text>
			}
			if hasHub {
				<circle
					class={ "hub", templ.KV("pending", hub.Pressed && c.Control.Pending[field] != "") }
					cx="90"
					cy="70"
					r="24"
					role="button"
					tabindex="0"
					data-value={ hub.Value }
					aria-label={ hub.Label }
					aria-pressed={ boolStr(hub.Pressed) }
					data-on:click={ "@post('/ui/units/" + c.Slug + "/" + path + "?" + param + "=" + hub.Value + "')" }
				><title>{ hub.Label }</title></circle>
			}
			<text class="center" x="90" y="70" text-anchor="middle" dominant-baseline="central">{ dialCenter(opts, path == "mode", hub) }</text>
		</svg>
	</div>
}

func boolStr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

// tempDial is the temperature wheel: drag a handle round the ring (dial.js);
// the centre shows the value, or the heat and cool pair in auto.
templ tempDial(c ui.CardView, w *TempWheel) {
	if w != nil {
		<div class="ctrl target">
			@roomTemp(c)
			<span class="ctrl-label">{ w.Title }</span>
			<div class="dial">
				<svg
					class="tdial"
					viewBox="0 0 180 134"
					role="group"
					data-min={ fnum(w.Min) }
					data-max={ fnum(w.Max) }
					data-step="0.5"
					data-gap={ fnum(tGap) }
					data-cx="90"
					data-cy="70"
					data-r="37"
					data-band?={ w.Band }
					data-on:tempcommit={ "@post('/ui/units/" + c.Slug + "/' + evt.detail.path + '?v=' + evt.detail.v)" }
				>
					<path class="track" d={ w.Track }></path>
					if !w.NA {
						<path class={ "fill", w.Kind } d={ w.Fill }></path>
						<text class="wl" x={ fmt.Sprintf("%.1f", w.MinX) } y={ fmt.Sprintf("%.1f", w.MinY) } text-anchor="middle" dominant-baseline="middle">{ w.MinLabel }</text>
						<text class="wl" x={ fmt.Sprintf("%.1f", w.MaxX) } y={ fmt.Sprintf("%.1f", w.MaxY) } text-anchor="middle" dominant-baseline="middle">{ w.MaxLabel }</text>
					}
					<text class={ "tval", templ.KV("na", w.NA) } x="90" y={ tvalY(w) } text-anchor="middle" dominant-baseline="central">{ w.Centre }</text>
					if !w.NA {
						<text class="wl" x="90" y="84" text-anchor="middle" dominant-baseline="middle">°C</text>
					}
					for _, h := range w.Handles {
						<circle
							class={ "handle", templ.KV("pending", h.Pending) }
							data-handle
							data-path={ h.Path }
							data-v={ fnum(h.V) }
							cx={ fmt.Sprintf("%.2f", h.X) }
							cy={ fmt.Sprintf("%.2f", h.Y) }
							r="8"
							tabindex="0"
							role="slider"
							aria-label={ h.Label }
							aria-valuemin={ fnum(w.Min) }
							aria-valuemax={ fnum(w.Max) }
							aria-valuenow={ fnum(h.V) }
						></circle>
					}
				</svg>
			</div>
		</div>
	}
}

// roomTemp is the measured room temperature, shown under the target wheel.
templ roomTemp(c ui.CardView) {
	<div class="room">
		<span>now</span>
		<b>{ c.RoomTemp } °C</b>
		if c.Humidity != "–" {
			<span class="rh">{ c.Humidity } % RH</span>
		}
	</div>
}

// scheduleSection is the schedule: the next event in the summary, the events
// of the running season in the body. The body is an island the unit's
// patches leave alone (data-ignore-morph), so an edit in progress survives
// them; the server swaps it with ScheduleBody / ScheduleEditor.
templ scheduleSection(c ui.CardView) {
	{{ sc := c.Schedule }}
	if sc.Present {
		<details class="kv schedule" data-preserve-attr="open" open>
			<summary>
				Schedule
				if !sc.Active {
					<span class="next-event">switched off</span>
				} else if sc.Next != "" {
					<span class="next-event">next: { sc.Next }</span>
				}
			</summary>
			if c.Hold.Show {
				@HoldControl(c)
			}
			@ScheduleBody(c)
		</details>
	} else if sc.Error != "" {
		<details class="kv schedule">
			<summary>Schedule <span class="next-event">unavailable</span></summary>
			<p class="season">{ sc.Error }</p>
		</details>
	}
}

// HoldControl is the hold radios. It sits outside the schedule body's
// data-ignore-morph island so a hold made in the Comfort app shows up; CSS
// floats it onto the season line. Choosing none, next or permanent posts at
// once; "until" waits for the time and the Set button.
templ HoldControl(c ui.CardView) {
	{{ h := c.Hold }}
	{{ post := "@post('/ui/units/" + c.Slug + "/hold', {contentType: 'form'})" }}
	<form class="hold-ctl" id={ "hold-ctl-" + c.Slug } title="Hold: keep these settings instead of the schedule's">
		<label><input type="radio" name="mode" value="none" checked?={ h.Mode == "none" } data-on:change={ post }/> No hold</label>
		if h.CanNext {
			<label><input type="radio" name="mode" value="next" checked?={ h.Mode == "next" } data-on:change={ post }/> Until next event</label>
		}
		<label><input type="radio" name="mode" value="until" checked?={ h.Mode == "until" }/> Until</label>
		<span class="hold-at" data-ignore-morph>
			<input type="time" name="at" value={ h.Time } data-on:change={ "el.form.elements.mode.value = 'until'; " + post }/>
			<button type="button" class="btn-inline" data-on:click={ "el.form.elements.mode.value = 'until'; " + post }>Set</button>
		</span>
		<label><input type="radio" name="mode" value="permanent" checked?={ h.Mode == "permanent" } data-on:change={ post }/> Permanent</label>
		<span class="hold-note">No hold applies the schedule's current settings.</span>
		<p class="hold-msg" id={ "hold-msg-" + c.Slug }></p>
	</form>
}

// ScheduleBody is the read-only table, with an edit button when the unit is writable.
templ ScheduleBody(c ui.CardView) {
	<div id={ "sched-body-" + c.Slug } class="sched-body" data-ignore-morph>
		<p class="season">{ c.Schedule.Heading }</p>
		<table class="schedule-table">
			<thead><tr><th>days</th><th>at</th><th>mode</th><th>target</th><th>fan</th></tr></thead>
			<tbody>
				for _, r := range c.Schedule.Rows {
					<tr class={ templ.KV("next", r.IsNext) }>
						<td>{ r.Days }</td>
						<td>{ r.At }</td>
						<td>{ r.Mode }</td>
						<td>{ r.Target }</td>
						<td>{ r.Fan }</td>
					</tr>
				}
			</tbody>
		</table>
		if c.Control.Writable {
			<div class="sched-actions">
				<button type="button" class="btn-inline" data-on:click={ "@get('/ui/units/" + c.Slug + "/schedule/edit')" }>Edit schedule</button>
			</div>
		}
	</div>
}

// ScheduleEditor is the editable table with Save and Cancel. msg shows above
// the buttons (an error from a failed save).
templ ScheduleEditor(slug, heading string, rows []ui.EditRow, o ui.EditOpts, msg string) {
	<div id={ "sched-body-" + slug } class="sched-body editing" data-ignore-morph>
		<p class="season">{ heading } · editing</p>
		<form>
			<table class="schedule-table sched-edit">
				<thead><tr><th>days</th><th>at</th><th>mode</th><th>target °C</th><th>fan</th><th></th></tr></thead>
				<tbody id={ "sched-rows-" + slug }>
					for _, r := range rows {
						@ScheduleEditRow(slug, r, o)
					}
				</tbody>
			</table>
			<div class="sched-actions">
				<button type="button" class="btn-inline" data-on:click={ "@get('/ui/units/" + slug + "/schedule/new-row')" }>+ add row</button>
			</div>
			<p class="sched-msg" id={ "sched-msg-" + slug }>{ msg }</p>
			<div class="sched-actions">
				<button type="button" class="btn-inline save" data-on:click={ "@post('/ui/units/" + slug + "/schedule', {contentType: 'form'})" }>Save</button>
				<button type="button" class="btn-inline" data-on:click={ "@get('/ui/units/" + slug + "/schedule/read')" }>Cancel</button>
			</div>
		</form>
	</div>
}

templ ScheduleEditRow(slug string, r ui.EditRow, o ui.EditOpts) {
	<tr data-mode={ r.Mode }>
		<td class="days">
			<input type="hidden" name="key" value={ r.Key }/>
			<input type="hidden" name="vane" value={ r.Vane }/>
			for _, d := range ui.DayChips {
				<label class="day"><input type="checkbox" name={ "days-" + r.Key } value={ d.Code } checked?={ r.Days[d.Code] }/><span>{ d.Short }</span></label>
			}
		</td>
		<td><input type="time" name="at" value={ r.At } required/></td>
		<td>
			<select name="mode" data-on:change="el.closest('tr').dataset.mode = el.value">
				for _, m := range o.Modes {
					<option value={ m.Value } selected?={ m.Value == r.Mode }>{ m.Label }</option>
				}
			</select>
		</td>
		<td class="sp">
			<input type="number" name="sph" class="sp-heat" step="0.5" min={ o.Lo } max={ o.Hi } value={ r.SpHeat } aria-label="heat to"/>
			<input type="number" name="spc" class="sp-cool" step="0.5" min={ o.Lo } max={ o.Hi } value={ r.SpCool } aria-label="cool to"/>
		</td>
		<td>
			<select name="fan">
				for _, f := range o.Fans {
					<option value={ f.Value } selected?={ f.Value == r.Fan }>{ f.Label }</option>
				}
			</select>
		</td>
		<td><button type="button" class="del" aria-label="delete row" data-on:click="el.closest('tr').remove()">×</button></td>
	</tr>
}
