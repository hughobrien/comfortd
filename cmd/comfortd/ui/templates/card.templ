package templates

import "github.com/hughobrien/comfortd/cmd/comfortd/ui"

templ Card(c ui.CardView) {
	<div class="card">
		if c.Stale {
			<p class="stale-banner">stale: no fresh data since { c.LastOK }</p>
		}
		<div class="big">{ c.Mode }</div>
		<dl>
			<dt>Power</dt><dd>{ c.Power }</dd>
			<dt>Room</dt><dd>{ c.RoomTemp } °C</dd>
			<dt>Heat to</dt><dd>{ c.SpHeat } °C</dd>
			<dt>Cool to</dt><dd>{ c.SpCool } °C</dd>
			<dt>Humidity</dt><dd>{ c.Humidity }</dd>
			<dt>Schedule</dt><dd>{ yesNo(c.ScheduleActive) }{ holdSuffix(c.HoldEnabled) }</dd>
			<dt>Adapter</dt><dd>{ connText(c.Connected) }</dd>
		</dl>
	</div>
}

func yesNo(b bool) string {
	if b {
		return "active"
	}
	return "none"
}

func holdSuffix(b bool) string {
	if b {
		return ", hold on"
	}
	return ""
}

func connText(b bool) string {
	if b {
		return "connected"
	}
	return "offline"
}
